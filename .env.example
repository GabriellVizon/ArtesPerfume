# =========================
# APLICAÇÃO
# =========================
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# =========================
# BANCO DE DADOS (PostgreSQL)
# =========================
# Compatível com o docker-compose.yml incluído no projeto.

DATABASE_URL=...
DB_SSL=true

# =========================
# SESSÃO ADMINISTRATIVA
# =========================
SESSION_COOKIE_NAME=ap_session
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# =========================
# CATÁLOGO
# =========================
CATALOGO_MODE=demo
CATALOGO_HASHTAG=puxarparaocatalogo

# =========================
# WHATSAPP
# =========================
# Formato: 55 + DDD + número, somente dígitos.
WHATSAPP_NUMBER=5514999999999


# =========================
# IDENTIDADE VISUAL PÚBLICA
# =========================
PUBLIC_BRAND_NAME=Aura Noir
PUBLIC_BRAND_SUBTITLE=Atelier
PUBLIC_INSTAGRAM_URL=

# =========================
# INSTAGRAM / META
# =========================
INSTAGRAM_LOGIN_MODE=facebook
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Exemplo: vXX.X. Preencha com uma versão atualmente suportada pela Meta.
META_API_VERSION=
